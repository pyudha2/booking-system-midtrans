generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum BookingStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

model Service {
  id       String    @id @default(cuid())
  name     String
  price    Int
  bookings Booking[]
}

model Booking {
  id        String        @id @default(cuid())
  serviceId String
  service   Service       @relation(fields: [serviceId], references: [id])
  startAt   DateTime
  slotKey   String?       @unique
  name      String
  email     String
  phone     String
  status    BookingStatus @default(PENDING)
  payUrl    String?       @db.Text
  createdAt DateTime      @default(now())
}